  "not_in_book": [
    {"terms": ["pacelc", "abadi"], "msg": "PACELC is not in the sources (only as an extrapolation label); see references/teorema-cap-e-teorema-pacelc.md"},
    {"terms": ["raft"], "msg": "Raft is not covered; STRAUCH p.100 describes majority and heartbeats in the 2010 replica set"},
    {"terms": ["oplog", "local.oplog.rs"], "msg": "The name oplog only appears in a bibliographic title (STRAUCH p.143); STRAUCH p.99 describes a capped collection of operations"},
    {"terms": ["bgsave", "bgrewriteaof", "appendfsync", "everysec", "copy-on-write", "fork"], "msg": "Redis persistence details are not covered; REDIS p.9 and p.29 only describe snapshot/append in broad strokes"},
    {"terms": ["maxmemory", "evicao", "eviction", "lru"], "msg": "Redis eviction/maxmemory are not covered by the sources"},
    {"terms": ["sentinel"], "msg": "Sentinel is not covered; REDIS p.29 says there is no automatic failover (dated)"},
    {"terms": ["skiplist", "skip list"], "msg": "SkipList is not covered"},
    {"terms": ["hashed sharding", "hashed", "md5"], "msg": "Hash-based sharding under that name is not covered; MONGO-PAT p.63 describes a semi-random key (hash of the _id)"},
    {"terms": ["wiredtiger"], "msg": "WiredTiger is not covered"},
    {"terms": ["subset pattern", "extended reference", "bucket pattern"], "msg": "Pattern names are not covered; MONGO-PAT p.131 uses 'buckets' only in the hybrid comments design"},
    {"terms": ["_rev", "409", "/_replicate"], "msg": "_rev, HTTP 409 and /_replicate are not covered in COUCH; see STRAUCH p.77 (revision number on update)"},
    {"terms": ["inverted index", "indice invertido", "bm25", "tf-idf", "translog"], "msg": "ELAST is only a landing page; inverted index is not covered"},
    {"terms": ["tombstone", "hinted handoff do cassandra", "consistency level", "local_quorum"], "msg": "Cassandra consistency levels and tombstones are not covered; hinted handoff is from Dynamo (STRAUCH p.63)"},
    {"terms": ["monotonic write"], "msg": "Monotonic write is not covered; STRAUCH p.36 lists RYOW, session, causal and monotonic read"},
    {"terms": ["fowler"], "msg": "Fowler is not cited; STRAUCH p.26 attributes the 'polyglot persistence' suggestion to Scofield"},
    {"terms": ["gbac", "knowledge graph", "grafo de conhecimento"], "msg": "GBAC and knowledge graphs are not covered; fraud only appears as an occasional example in NEO4J-GDB p.36 and p.42; use cases listed in p.124-129: social, recommendation, geo, MDM, network and authorization"}
  ]
